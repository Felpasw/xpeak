root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# .NET convention: 4-space indent for C#/csproj-related files.
[*.{cs,csproj,sln,props,targets}]
indent_size = 4
