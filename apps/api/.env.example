# Xpeak API — environment variables (dev)
#
# Copy to `.env` and fill in. Never commit `.env`.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

# EF Core / Npgsql connection string.
# When running from `docker compose`, `postgres` resolves to the postgres
# service. When running the SDK on the host, use `localhost:5433`.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=xpeak_dev;Username=xpeak;Password=xpeak

# JWT signing key — generate with `openssl rand -base64 48`
Jwt__Key=change-me-generate-with-openssl-rand-base64-48
Jwt__Issuer=xpeak
Jwt__Audience=xpeak

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (dev):
#   http://localhost:5000/signin-google
#   http://localhost:5000/auth/google/callback
Google__ClientId=
Google__ClientSecret=

# Deep-link URI used by the OAuth callback to hand the JWT back to the app
Auth__CallbackUri=xpeak://auth/callback
